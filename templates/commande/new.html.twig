{% extends 'base.html.twig' %}

{% block title %}Nouvelle Commande - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .commande-materiels-collection .card {
            margin-bottom: 1rem;
        }
        .collection-item {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-bottom: 1rem;
            background-color: #f8f9fa;
        }
    </style>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">
                    <i class="bi bi-plus-circle"></i> Nouvelle commande de location
                </h3>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-4">
                        {{ form_label(form.nomClient, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nomClient) }}
                        {{ form_errors(form.nomClient) }}
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Matériels à louer</label>
                        <div id="commande-materiels-collection" 
                             data-prototype="{{ form_widget(form.commandeMateriels.vars.prototype)|e('html_attr') }}"
                             data-index="{{ form.commandeMateriels|length }}">
                            {% for commandeMaterielForm in form.commandeMateriels %}
                                <div class="collection-item" data-index="{{ loop.index0 }}">
                                    <div class="row align-items-end">
                                        <div class="col-md-8">
                                            {{ form_label(commandeMaterielForm.materiel, 'Matériel', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(commandeMaterielForm.materiel) }}
                                            {{ form_errors(commandeMaterielForm.materiel) }}
                                        </div>
                                        <div class="col-md-3">
                                            {{ form_label(commandeMaterielForm.quantite, 'Quantité', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(commandeMaterielForm.quantite) }}
                                            {{ form_errors(commandeMaterielForm.quantite) }}
                                        </div>
                                        <div class="col-md-1">
                                            <button type="button" class="btn btn-danger btn-sm remove-item">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <button type="button" id="add-materiel" class="btn btn-outline-primary">
                            <i class="bi bi-plus"></i> Ajouter un matériel
                        </button>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_commande_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Retour
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Créer la commande
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const collectionHolder = document.getElementById('commande-materiels-collection');
            const addButton = document.getElementById('add-materiel');
            
            let index = parseInt(collectionHolder.dataset.index);

            function addRemoveListener(item) {
                const removeButton = item.querySelector('.remove-item');
                if (removeButton) {
                    removeButton.addEventListener('click', function() {
                        item.remove();
                    });
                }
            }

            addButton.addEventListener('click', function() {
                const prototype = collectionHolder.dataset.prototype;
                const newForm = prototype.replace(/__name__/g, index);
                
                // Créer un conteneur temporaire pour parser le HTML
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = newForm;
                
                // Créer la nouvelle ligne
                const wrapper = document.createElement('div');
                wrapper.className = 'collection-item';
                wrapper.dataset.index = index;
                
                // Extraire les champs du prototype
                const materielSelect = tempDiv.querySelector('select');
                const quantiteInput = tempDiv.querySelector('input[type="number"]');
                
                wrapper.innerHTML = `
                    <div class="row align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">Matériel</label>
                            ${materielSelect ? materielSelect.outerHTML : ''}
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantité</label>
                            ${quantiteInput ? quantiteInput.outerHTML : ''}
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-danger btn-sm remove-item">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
                
                collectionHolder.appendChild(wrapper);
                addRemoveListener(wrapper);
                
                index++;
                collectionHolder.dataset.index = index;
            });

            // Ajouter l'événement de suppression aux éléments existants
            document.querySelectorAll('.collection-item').forEach(addRemoveListener);
        });
    </script>
{% endblock %}
