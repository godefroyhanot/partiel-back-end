{% extends 'base.html.twig' %}

{% block title %}Commande #{{ commande.id }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-receipt"></i> Commande #{{ commande.id }}
                </h3>
                <span class="badge bg-primary fs-6">{{ commande.dateCreation|date('d/m/Y H:i') }}</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Informations client</h5>
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Nom du client :</strong></td>
                                <td>{{ commande.nomClient }}</td>
                            </tr>
                            <tr>
                                <td><strong>Date de commande :</strong></td>
                                <td>{{ commande.dateCreation|date('d/m/Y à H:i') }}</td>
                            </tr>
                            <tr>
                                <td><strong>Prix total :</strong></td>
                                <td><span class="fw-bold text-success fs-5">{{ commande.prixTotal }}€</span></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Résumé de la commande</h5>
                        <div class="alert alert-info">
                            <p class="mb-1"><strong>Nombre d'articles :</strong> {{ commande.commandeMateriels|length }}</p>
                            <p class="mb-0"><strong>Total :</strong> {{ commande.prixTotal }}€</p>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Détail des matériels loués</h5>
                {% if commande.commandeMateriels is empty %}
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> Aucun matériel dans cette commande.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Matériel</th>
                                    <th>Prix unitaire</th>
                                    <th>Quantité</th>
                                    <th>Sous-total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commandeMateriel in commande.commandeMateriels %}
                                    <tr>
                                        <td>
                                            <strong>{{ commandeMateriel.materiel.nom }}</strong>
                                        </td>
                                        <td>{{ commandeMateriel.prixUnitaire }}€</td>
                                        <td>
                                            <span class="badge bg-info">{{ commandeMateriel.quantite }}</span>
                                        </td>
                                        <td>
                                            <strong>{{ commandeMateriel.prixTotal|number_format(2, '.', '') }}€</strong>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="table-dark">
                                <tr>
                                    <th colspan="3">Total</th>
                                    <th>{{ commande.prixTotal }}€</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                {% endif %}
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_commande_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Retour à la liste
                    </a>
                    <form method="post" action="{{ path('app_commande_rendre', {'id': commande.id}) }}" 
                          style="display: inline;" 
                          onsubmit="return confirm('Êtes-vous sûr de vouloir rendre cette commande ? Le matériel sera remis en stock et la commande sera supprimée. Cette action est irréversible.')">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-arrow-return-left"></i> Rendre la commande
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
