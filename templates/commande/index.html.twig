{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes - {{ parent() }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-receipt"></i> Gestion des Commandes</h1>
    <a href="{{ path('app_commande_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle commande
    </a>
</div>

{% if commandes is empty %}
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> Aucune commande</h4>
        <p>Vous n'avez pas encore créé de commande de location.</p>
        <a href="{{ path('app_commande_new') }}" class="btn btn-primary">Créer la première commande</a>
    </div>
{% else %}
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Matériels</th>
                            <th>Prix total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">#{{ commande.id }}</span>
                                </td>
                                <td>
                                    <strong>{{ commande.nomClient }}</strong>
                                </td>
                                <td>
                                    {{ commande.dateCreation|date('d/m/Y H:i') }}
                                </td>
                                <td>
                                    {% for commandeMateriel in commande.commandeMateriels %}
                                        <span class="badge bg-info me-1">
                                            {{ commandeMateriel.materiel.nom }} ({{ commandeMateriel.quantite }})
                                        </span>
                                    {% endfor %}
                                </td>
                                <td>
                                    <span class="fw-bold text-success">{{ commande.prixTotal }}€</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_commande_show', {'id': commande.id}) }}" 
                                           class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i> Voir
                                        </a>
                                        <form method="post" action="{{ path('app_commande_rendre', {'id': commande.id}) }}" 
                                              style="display: inline;" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir rendre cette commande ? Cette action est irréversible.')">
                                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-arrow-return-left"></i> Rendre
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
