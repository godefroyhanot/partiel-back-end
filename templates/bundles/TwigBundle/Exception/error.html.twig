{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">
                    <i class="bi bi-exclamation-triangle"></i> Erreur {{ status_code }}
                </h3>
            </div>
            <div class="card-body text-center">
                {% if status_code == 404 %}
                    <i class="bi bi-search display-1 text-muted mb-4"></i>
                    <h4>Page non trouvée</h4>
                    <p class="text-muted">La page que vous recherchez n'existe pas ou a été déplacée.</p>
                {% elseif status_code == 403 %}
                    <i class="bi bi-shield-exclamation display-1 text-muted mb-4"></i>
                    <h4>Accès interdit</h4>
                    <p class="text-muted">Vous n'avez pas les permissions nécessaires pour accéder à cette ressource.</p>
                {% elseif status_code == 500 %}
                    <i class="bi bi-bug display-1 text-muted mb-4"></i>
                    <h4>Erreur interne du serveur</h4>
                    <p class="text-muted">Une erreur inattendue s'est produite. Veuillez réessayer plus tard.</p>
                {% else %}
                    <i class="bi bi-exclamation-circle display-1 text-muted mb-4"></i>
                    <h4>{{ status_text }}</h4>
                    <p class="text-muted">Une erreur s'est produite lors du traitement de votre demande.</p>
                {% endif %}
                
                <div class="mt-4">
                    <a href="{{ path('app_home') }}" class="btn btn-primary me-2">
                        <i class="bi bi-house"></i> Retour à l'accueil
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Page précédente
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
