{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ parent() }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="jumbotron bg-primary text-white p-5 rounded mb-4">
            <h1 class="display-4">
                <i class="bi bi-water"></i> Parc du Lac de Poses
            </h1>
            <p class="lead">Système de gestion de location de matériel nautique</p>
            <hr class="my-4">
            <p>Gérez facilement votre inventaire de matériel et les commandes de location.</p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Statistiques -->
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-box display-4 text-primary"></i>
                <h5 class="card-title mt-3">Matériels</h5>
                <h2 class="text-primary">{{ total_materiels }}</h2>
                <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-primary">Voir tout</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-receipt display-4 text-success"></i>
                <h5 class="card-title mt-3">Commandes</h5>
                <h2 class="text-success">{{ total_commandes }}</h2>
                <a href="{{ path('app_commande_index') }}" class="btn btn-outline-success">Voir tout</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-plus-circle display-4 text-info"></i>
                <h5 class="card-title mt-3">Nouveau matériel</h5>
                <p class="card-text">Ajouter du matériel</p>
                <a href="{{ path('app_materiel_new') }}" class="btn btn-info">Ajouter</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-cart-plus display-4 text-warning"></i>
                <h5 class="card-title mt-3">Nouvelle commande</h5>
                <p class="card-text">Créer une location</p>
                <a href="{{ path('app_commande_new') }}" class="btn btn-warning">Créer</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Matériels récents -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-box"></i> Matériels disponibles
                </h5>
            </div>
            <div class="card-body">
                {% if materiels is empty %}
                    <p class="text-muted">Aucun matériel enregistré.</p>
                    <a href="{{ path('app_materiel_new') }}" class="btn btn-primary">Ajouter du matériel</a>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Stock</th>
                                    <th>Prix</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for materiel in materiels %}
                                    <tr>
                                        <td>{{ materiel.nom }}</td>
                                        <td>
                                            <span class="badge {{ materiel.quantiteDisponible > 0 ? 'bg-success' : 'bg-danger' }}">
                                                {{ materiel.quantiteDisponible }}
                                            </span>
                                        </td>
                                        <td>{{ materiel.prixLocation }}€</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-primary btn-sm">Voir tout le matériel</a>
                {% endif %}
            </div>
        </div>
    </div>
    
    <!-- Commandes récentes -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-receipt"></i> Commandes récentes
                </h5>
            </div>
            <div class="card-body">
                {% if commandes_recentes is empty %}
                    <p class="text-muted">Aucune commande enregistrée.</p>
                    <a href="{{ path('app_commande_new') }}" class="btn btn-primary">Créer une commande</a>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Total</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commande in commandes_recentes %}
                                    <tr>
                                        <td>{{ commande.nomClient }}</td>
                                        <td>{{ commande.prixTotal }}€</td>
                                        <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <a href="{{ path('app_commande_index') }}" class="btn btn-outline-success btn-sm">Voir toutes les commandes</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
