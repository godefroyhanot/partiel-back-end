{% extends 'base.html.twig' %}

{% block title %}Gestion du Matériel - {{ parent() }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-box"></i> Gestion du Matériel</h1>
    <a href="{{ path('app_materiel_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter du matériel
    </a>
</div>

{% if materiels is empty %}
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> Aucun matériel</h4>
        <p>Vous n'avez pas encore ajouté de matériel à votre inventaire.</p>
        <a href="{{ path('app_materiel_new') }}" class="btn btn-primary">Ajouter le premier matériel</a>
    </div>
{% else %}
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nom</th>
                            <th>Quantité disponible</th>
                            <th>Prix de location</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for materiel in materiels %}
                            <tr>
                                <td>
                                    <strong>{{ materiel.nom }}</strong>
                                </td>
                                <td>
                                    <span class="badge fs-6 {{ materiel.quantiteDisponible > 0 ? 'bg-success' : 'bg-danger' }}">
                                        {{ materiel.quantiteDisponible }}
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">{{ materiel.prixLocation }}€</span>
                                </td>
                                <td>
                                    {% if materiel.quantiteDisponible > 5 %}
                                        <span class="badge bg-success">En stock</span>
                                    {% elseif materiel.quantiteDisponible > 0 %}
                                        <span class="badge bg-warning">Stock faible</span>
                                    {% else %}
                                        <span class="badge bg-danger">Rupture</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_materiel_show', {'id': materiel.id}) }}" 
                                           class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('app_materiel_edit', {'id': materiel.id}) }}" 
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
