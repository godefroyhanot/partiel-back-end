{% extends 'base.html.twig' %}

{% block title %}{{ materiel.nom }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">
                    <i class="bi bi-box"></i> {{ materiel.nom }}
                </h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Informations générales</h5>
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Nom :</strong></td>
                                <td>{{ materiel.nom }}</td>
                            </tr>
                            <tr>
                                <td><strong>Quantité disponible :</strong></td>
                                <td>
                                    <span class="badge fs-6 {{ materiel.quantiteDisponible > 0 ? 'bg-success' : 'bg-danger' }}">
                                        {{ materiel.quantiteDisponible }}
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Prix de location :</strong></td>
                                <td><span class="fw-bold text-primary">{{ materiel.prixLocation }}€</span></td>
                            </tr>
                            <tr>
                                <td><strong>Statut :</strong></td>
                                <td>
                                    {% if materiel.quantiteDisponible > 5 %}
                                        <span class="badge bg-success">En stock</span>
                                    {% elseif materiel.quantiteDisponible > 0 %}
                                        <span class="badge bg-warning">Stock faible</span>
                                    {% else %}
                                        <span class="badge bg-danger">Rupture</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Locations en cours</h5>
                        {% if materiel.commandeMateriels is empty %}
                            <p class="text-muted">Aucune location en cours pour ce matériel.</p>
                        {% else %}
                            <div class="list-group">
                                {% for commandeMateriel in materiel.commandeMateriels %}
                                    <div class="list-group-item">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">{{ commandeMateriel.commande.nomClient }}</h6>
                                            <small>{{ commandeMateriel.commande.dateCreation|date('d/m/Y') }}</small>
                                        </div>
                                        <p class="mb-1">Quantité : {{ commandeMateriel.quantite }}</p>
                                        <small>Prix unitaire : {{ commandeMateriel.prixUnitaire }}€</small>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_materiel_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Retour à la liste
                    </a>
                    <a href="{{ path('app_materiel_edit', {'id': materiel.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Modifier
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
